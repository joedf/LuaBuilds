#include "common.h"
0  ICON  "lua_powered.ico"

1 VERSIONINFO
FILEVERSION LUA_VERSION
PRODUCTVERSION LUA_VERSION
FILEOS 0x0
FILETYPE 0x0
{
	BLOCK "StringFileInfo"
	{
		BLOCK "040904b0"
		{
			VALUE "Comments", G_COMMENTS
			VALUE "CompanyName", G_COMPANYNAME
			VALUE "FileDescription", "Lua executable script wrapper"
			VALUE "FileVersion", LUA_VERSION_STR
			VALUE "LegalCopyright", G_LEGALCOPYRIGHT
			VALUE "OriginalFilename", "srlua.exe"
			VALUE "ProductName", "srLua - Lua executable script wrapper"
			VALUE "ProductVersion", LUA_VERSION_STR
			VALUE "PrivateBuild", G_PRIVATEBUILD
		}
	}
	BLOCK "VarFileInfo"
	{
		VALUE "Translation", 0x0409, 0x04E4
	}
}